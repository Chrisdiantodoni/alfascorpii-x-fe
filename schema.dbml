table areas {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    name [name: 'areas_name_unique', unique]
  }
}

table banners {
  id char(26) [pk, not null]
  title varchar(255)
  subtitle varchar(255)
  file_path varchar(255)
  click_url varchar(255)
  cta_text varchar(255)
  text_color varchar(255) [not null, default: 'light']
  overlay boolean [not null, default: true]
  placement varchar(255) [not null]
  order_position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  start_date timestamp
  end_date timestamp
  bannerable_type varchar(255)
  bannerable_id char(26)
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  field_settings json

  indexes {
    (bannerable_type, bannerable_id)
  }
}

table blog_categories {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  slug varchar(255) [not null]
  order_index integer [not null, default: 0]
  is_active boolean [not null, default: true]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    slug [name: 'blog_categories_slug_unique', unique]
  }
}

table blogs {
  id char(26) [pk, not null]
  user_id char(26) [not null]
  title varchar(255) [not null]
  blog_category_id char(26) [not null]
  slug varchar(255) [not null]
  excerpt text
  content text [not null]
  status varchar(255) [not null, default: 'draft']
  deleted_at timestamp
  published_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    
    
    slug [name: 'blogs_slug_unique', unique]
  }
}

table cache {
  key varchar(255) [pk, not null]
  value text [not null]
  expiration integer [not null]
}

table cache_locks {
  key varchar(255) [pk, not null]
  owner varchar(255) [not null]
  expiration integer [not null]
}

table categories {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  slug varchar(255) [not null]
  order_index integer [not null, default: 0]
  is_active boolean [not null, default: true]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  show_in_menu boolean [not null, default: true]
  spec_template jsonb

  indexes {
    slug [name: 'categories_slug_unique', unique]
  }
}

table failed_jobs {
  id bigserial [pk, not null, increment]
  uuid varchar(255) [not null]
  connection text [not null]
  queue text [not null]
  payload text [not null]
  exception text [not null]
  failed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    uuid [name: 'failed_jobs_uuid_unique', unique]
  }
}

table files {
  id char(26) [pk, not null]
  file_path varchar(255) [not null]
  file_type varchar(255)
  file_size integer
  disk varchar(255) [not null, default: 'local']
  fileable_type varchar(255) [not null]
  fileable_id char(26) [not null]
  role varchar(255) [not null, default: 'gallery']
  sort_order integer [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (fileable_type, fileable_id)
  }
}

table inquiries {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  whatsapp_number varchar(255) [not null]
  email varchar(255)
  subject varchar(255) [not null]
  message text [not null]
  status varchar(255) [not null, default: 'new']
  admin_notes text
  created_at timestamp
  updated_at timestamp
}

table job_batches {
  id varchar(255) [pk, not null]
  name varchar(255) [not null]
  total_jobs integer [not null]
  pending_jobs integer [not null]
  failed_jobs integer [not null]
  failed_job_ids text [not null]
  options text
  cancelled_at integer
  created_at integer [not null]
  finished_at integer
}

table jobs {
  id bigserial [pk, not null, increment]
  queue varchar(255) [not null]
  payload text [not null]
  attempts smallint [not null]
  reserved_at integer
  available_at integer [not null]
  created_at integer [not null]

  indexes {
    queue
  }
}

table menu_items {
  id char(26) [pk, not null]
  menu_id char(26) [not null]
  parent_id char(26)
  type varchar(255) [not null]
  reference_id varchar(255)
  label varchar(255)
  url varchar(255)
  order_index integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
}

table menus {
  id char(26) [pk, not null]
  location varchar(255) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    location [name: 'menus_location_unique', unique]
  }
}

table migrations {
  id serial [pk, not null, increment]
  migration varchar(255) [not null]
  batch integer [not null]
}

table model_has_permissions {
  permission_id uuid [not null]
  model_type varchar(255) [not null]
  model_uuid char(26) [not null]

  indexes {
    (model_uuid, model_type) [name: 'model_has_permissions_model_id_model_type_index']
    
    (permission_id, model_type, model_uuid) [pk]
  }
}

table model_has_roles {
  role_id uuid [not null]
  model_type varchar(255) [not null]
  model_uuid char(26) [not null]

  indexes {
    (model_uuid, model_type) [name: 'model_has_roles_model_id_model_type_index']
    
    (role_id, model_type, model_uuid) [pk]
  }
}

table pages {
  id char(26) [pk, not null]
  title varchar(255) [not null]
  slug varchar(255) [not null]
  content text [not null]
  deleted_at timestamp
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
  order_index text [not null]

  indexes {
    slug [name: 'pages_slug_unique', unique]
  }
}

table password_reset_tokens {
  email varchar(255) [pk, not null]
  token varchar(255) [not null]
  created_at timestamp
}

table permissions {
  uuid uuid [pk, not null]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
  group_name varchar(255)

  indexes {
    (name, guard_name) [name: 'permissions_name_guard_name_unique', unique]
  }
}

table personal_access_tokens {
  id bigserial [pk, not null, increment]
  tokenable_type varchar(255) [not null]
  tokenable_id char(26) [not null]
  name text [not null]
  token varchar(64) [not null]
  abilities text
  last_used_at timestamp
  expires_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    expires_at
    (tokenable_type, tokenable_id)
    token [name: 'personal_access_tokens_token_unique', unique]
  }
}

table product_colors {
  id char(26) [pk, not null]
  product_id char(26) [not null]
  name varchar(255) [not null]
  hex varchar(255) [not null]
  order_index integer [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

table products {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  slug varchar(255) [not null]
  code varchar(255)
  description text
  sub_category_id char(26) [not null]
  price "numeric(12, 2)" [not null, default: '0']
  weight "numeric(9, 2)"
  length "numeric(9, 2)"
  width "numeric(9, 2)"
  height "numeric(9, 2)"
  stock integer [not null, default: 0]
  is_active boolean [not null, default: true]
  spec_values jsonb
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    
    slug [name: 'products_slug_unique', unique]
  }
}

table related_products {
  product_id char(26) [not null]
  related_product_id char(26) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    
    
    (product_id, related_product_id) [pk]
    (product_id, related_product_id) [name: 'related_products_product_id_related_product_id_unique', unique]
  }
}

table role_has_permissions {
  permission_id uuid [not null]
  role_id uuid [not null]

  indexes {
    
    
    (permission_id, role_id) [pk]
  }
}

table roles {
  uuid uuid [pk, not null]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, guard_name) [name: 'roles_name_guard_name_unique', unique]
  }
}

table seo_metadata {
  id char(26) [pk, not null]
  seoable_type varchar(255) [not null]
  seoable_id char(26) [not null]
  meta_title varchar(255)
  meta_description text
  meta_keywords varchar(255)
  og_image_path varchar(255)
  created_at timestamp
  updated_at timestamp

  indexes {
    (seoable_type, seoable_id)
  }
}

table sessions {
  id varchar(255) [pk, not null]
  user_id char(26)
  ip_address varchar(45)
  user_agent text
  payload text [not null]
  last_activity integer [not null]

  indexes {
    last_activity
    user_id
  }
}

table site_settings {
  id char(26) [pk, not null]
  key varchar(255) [not null]
  value jsonb [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    key [name: 'site_settings_key_unique', unique]
  }
}

table sub_categories {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  slug varchar(255) [not null]
  category_id char(26)
  order_index integer [not null, default: 0]
  is_active boolean [not null, default: true]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  show_in_menu boolean [not null, default: true]

  indexes {
    
    slug [name: 'sub_categories_slug_unique', unique]
  }
}

table users {
  id char(26) [pk, not null]
  name varchar(255) [not null]
  username varchar(255) [not null]
  email varchar(255) [not null]
  email_verified_at timestamp
  password varchar(255) [not null]
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
  password_reset_at timestamp

  indexes {
    username [name: 'users_username_unique', unique]
    email [name: 'users_email_unique', unique]
  }
}

table auth_account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id [name: 'account_userId_idx']
  }
}

table auth_session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table auth_user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table auth_verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

ref: blogs.user_id > users.id

ref: blogs.blog_category_id > blog_categories.id

ref: menu_items.menu_id > menus.id

ref: menu_items.parent_id > menu_items.id

ref: model_has_permissions.permission_id > permissions.uuid

ref: model_has_roles.role_id > roles.uuid

ref: product_colors.product_id > products.id

ref: products.sub_category_id > sub_categories.id

ref: related_products.product_id > products.id

ref: related_products.related_product_id > products.id

ref: role_has_permissions.permission_id > permissions.uuid

ref: role_has_permissions.role_id > roles.uuid

ref: sub_categories.category_id > categories.id

ref: auth_account.user_id > auth_user.id

ref: auth_session.user_id > auth_user.id